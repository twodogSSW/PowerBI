  <DataSources>
    <DataSource Name="DSMusic">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=STDESKTOP\MSSQLSERVER02;Initial Catalog=Music2024</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>58cea85f-2099-484e-8ee1-b0ee71ad5ba8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DS_Region">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Region">
            <Value>=Parameters!Region.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT
    r.Region,
    geo.City,
    t.pkTrackList,
    --t.Title,
    a.Artist,    
    ts.Salesdate,
    ts.SalesAmt
FROM dbo.TrackList AS t
LEFT JOIN dbo.Artist     AS a  ON t.fkArtist        = a.pkArtist
LEFT JOIN dbo.TrackSales AS ts ON t.pkTrackList     = ts.fkTrackList
LEFT JOIN dbo.Geography    geo ON geo.pkGeography   = ts.fkGeographyNo
LEFT JOIN dbo.Region        r  on r.pkRegion        = geo.fkRegion
WHERE  
r.pkRegion IN (@Region)
  AND (@StartDate IS NULL OR ts.Salesdate &gt;= @StartDate)
  AND (@EndDate IS NULL OR ts.Salesdate &lt;= @EndDate)</CommandText>
      </Query>
      <Fields>
        <Field Name="Region">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Region</DataField>
        </Field>
        <Field Name="pkTrackList">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>pkTrackList</DataField>
        </Field>
        <Field Name="City">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>City</DataField>
        </Field>
        <Field Name="Artist">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Artist</DataField>
        </Field>
        <Field Name="Salesdate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Salesdate</DataField>
        </Field>
        <Field Name="SalesAmt">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>SalesAmt</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
