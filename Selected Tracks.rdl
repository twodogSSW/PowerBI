&amp; vbCrLf  
  
  &amp; vbCrLf 
&amp; "Sales: " &amp; Format(Sum(Fields!SalesAmt.Value), "$#,##0") 
  &amp; vbCrLf &amp; "Album: " &amp; Fields!Album.Value
  &amp; vbCrLf &amp; "Composer: " &amp; Fields!Composer.Value
  &amp; vbCrLf &amp; "Genre: " &amp; Fields!Genre.Value</Value>
