/// Measures used in Business Drivers Page
table _BusinessDrivers
	lineageTag: 125cf666-bac4-4cb7-88a1-30430f5a442f

	measure AlbumSales$_MonthlyKPI_HTML =
			
			VAR MonthlySales =
			    ADDCOLUMNS (
			        VALUES ( 'Calendar'[Start of Month] ),
			        "@CurSales", CALCULATE ( SUM ( AlbumSales[SalesAmt] ) ),
			        "@PrevSales", CALCULATE ( SUM ( AlbumSales[SalesAmt] ), DATEADD ( 'Calendar'[Date], -1, MONTH ) )
			    )
			VAR MonthlySalesFiltered =
			    FILTER ( MonthlySales, NOT ISBLANK ( [@CurSales] ) )
			RETURN
			    CONCATENATEX (
			        MonthlySalesFiltered,
			        VAR FontColor  = IF ( [@CurSales] > [@PrevSales], "#2E7D32", "#C62828" )
			        VAR MonthLabel = FORMAT ( 'Calendar'[Start of Month], "mmmm yyyy" )
			        VAR AmtLabel   = FORMAT ( [@CurSales], "$#,##0" )
			        RETURN
			            "<div style='color:" & FontColor & "; font-weight:600;'>" & MonthLabel & "  " & AmtLabel & "</div>",
			        "",
			        'Calendar'[Start of Month], ASC
			    )
		displayFolder: _TempClaude
		lineageTag: c4f74e54-4c12-46af-9ab1-5e0503e4e5a4

	measure TrackSales$_MonthlyKPI_HTML =
			
			VAR MonthlySales =
			    ADDCOLUMNS (
			        VALUES ( 'Calendar'[Start of Month] ),
			        "@CurSales", CALCULATE ( SUM ( TrackSales[SalesAmt] ) ),
			        "@PrevSales", CALCULATE ( SUM ( TrackSales[SalesAmt] ), DATEADD ( 'Calendar'[Date], -1, MONTH ) )
			    )
			VAR MonthlySalesFiltered =
			    FILTER ( MonthlySales, NOT ISBLANK ( [@CurSales] ) )
			RETURN
			    CONCATENATEX (
			        MonthlySalesFiltered,
			        VAR FontColor  = IF ( [@CurSales] > [@PrevSales], "#2E7D32", "#C62828" )
			        VAR MonthLabel = FORMAT ( 'Calendar'[Start of Month], "mmmm yyyy" )
			        VAR AmtLabel   = FORMAT ( [@CurSales], "$#,##0" )
			        RETURN
			            "<div style='color:" & FontColor & "; font-weight:600;'>" & MonthLabel & "  " & AmtLabel & "</div>",
			        "",
			        'Calendar'[Start of Month], ASC
			    )
		displayFolder: _TempClaude
		lineageTag: d3284426-f221-410e-819d-1cab3dc826cd

	/// Demographic
	column Demographic
		lineageTag: eb02ec91-51bd-4dcb-8412-ef145906a944
		summarizeBy: none
		isNameInferred
		sourceColumn: [Demographic]

		annotation SummarizationSetBy = Automatic

	/// DisplayName
	column DisplayName
		lineageTag: 0260a439-2a4e-49b2-bfed-b30334b7c933
		summarizeBy: none
		isNameInferred
		sourceColumn: [DisplayName]
		sortByColumn: SortOrder

		annotation SummarizationSetBy = Automatic

	/// SortOrder
	column SortOrder
		formatString: 0
		lineageTag: 6b6cb347-ddb7-4f35-8c15-7abbbf8a34c1
		summarizeBy: sum
		isNameInferred
		sourceColumn: [SortOrder]

		annotation SummarizationSetBy = Automatic

	partition _BusinessDrivers = calculated
		mode: import
		source =
				
				DATATABLE(
				    "Demographic", STRING,
				    "DisplayName", STRING,
				    "SortOrder", INTEGER,
				        {
				            {"Males18",     "Men 18",        1},
				            {"Males1834",   "Men 18–34",     2},
				            {"Males3454",   "Men 34–54",     3},
				            {"Males54",     "Men 54+",       4},
				            {"Females18",   "Women 18",      5},
				            {"Females1834", "Women 18–34",   6},
				            {"Females3454", "Women 34–54",   7},
				            {"Females54",   "Women 54+",     8}
				        }
				)

	annotation PBI_Id = 135c6a3e84d74716937eec6a0ccd83a3

