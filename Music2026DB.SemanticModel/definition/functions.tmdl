function 'pbi.NumberFormat' =
		() =>
		    VAR _value = SELECTEDMEASURE()
		    VAR _absvalue = ABS(_value)
		    VAR _fstring =
		        SWITCH(TRUE(),
		            _absvalue >=1e9, "#,##0,,,.00M",
		            _absvalue >=1e6, "#,##0,,,.0M",
		            _absvalue >=1e3, "#,##0,,,.0K",
		            "#,##0"
		        )
		    RETURN
		    _fstring
	lineageTag: b0104ed6-ec6f-43a8-8bfc-ad244fe4a9ce

function 'pbi.All_SelectedCategory' = ```
		() 
			=>
		    // Get the number of the item chosen in the category
			VAR SEL = SELECTEDVALUE( _Categories[Category Order], -1 )
		    RETURN SEL
		```
	lineageTag: ce5a0d13-192b-4dff-af95-e562bca50435

function 'pbi.GetTopCategory' = ```
		
			 	(Category:anyref, SalesColumn:anyref, DateColumn:anyref) 
				=>
			
		    VAR TopCategory =
		        CONCATENATEX(
		            FILTER(
		                VALUES(Category),
		                RANKX(
		                    ALL(Category),
		                    CALCULATE(
		                        SUM(SalesColumn),
		                        KEEPFILTERS(DateColumn)
		                    )
		                ) = 1
		            ),
		            Category,
		            "" 
		        )
		    RETURN TopCategory
		```
	lineageTag: cdf68ac8-2c00-4155-a1f4-13f8a3547729

function 'pbi.TopCombo' = ```
		
			 	(Category:anyref,SalesColumn:anyref,CountColumn:anyref)  
				=>
			
			Var Combo =
		       Category & 
			    UNICHAR(10) & format(SalesColumn, "$#,##0" ) & 
		        UNICHAR(10) & format(CountColumn, "#,##0" )
		
			RETURN Combo
		```
	lineageTag: cf76ff40-59bd-4e04-9ae7-557c031f1be5

function 'pbi.GetTopCategoryCnt' = ```
		
				(Category:anyref, SalesColumn:anyref, DateColumn:anyref, CategoryFld:anyref) 
				=>
		
		VAR NameVal = CategoryFld
		VAR VAL = 
		    IF( ISBLANK(NameVal), BLANK(),
		    CALCULATE( SalesColumn, KEEPFILTERS( DateColumn ), Category = NameVal )
		    )
		
		RETURN "# Sold - " & FORMAT(VAL, "#,##0")
		```
	lineageTag: 4950adf3-e91c-46ef-93dd-ff78e980a7f0

function 'pbi.GetTopCategoryDol' = ```
		
				(Category:anyref, SalesColumn:anyref, DateColumn:anyref, CategoryFld:anyref) 
				=>
		
		VAR NameVal = CategoryFld
		VAR VAL = 
		    IF( ISBLANK(NameVal), BLANK(),
		    CALCULATE( SalesColumn, KEEPFILTERS( DateColumn ), Category = NameVal )
		    )
		
		RETURN "Revenue - " & FORMAT(VAL, "$#,##0")
		```
