function 'pbi.All_Sales_CurDividedByPrev' = ```
		(SalesCategory:anyref,CalNumber: numeric) 
				=>
			
			Var CalNumberNeg = (-1 * CalNumber)
		
		    VAR CurrentPeriod =
		        CALCULATE(            
					SalesCategory,
		            DATESINPERIOD('Calendar'[Date], TODAY(), CalNumberNeg, DAY),
		            REMOVEFILTERS('Calendar')
		        )
		    VAR PreviousPeriod =
		        CALCULATE(
		            SalesCategory,
		            DATESINPERIOD('Calendar'[Date], TODAY() - CalNumber, CalNumberNeg, DAY),
		            REMOVEFILTERS('Calendar')
		        )
		    RETURN
				DIVIDE(CurrentPeriod - PreviousPeriod, PreviousPeriod, 0)
		```
	lineageTag: 83e54ac3-8975-4a27-9b8d-2564e037d765

function 'pbi.All_CalendarDateDiff' = ```
		(CurDate:datetime,PrevDate:datetime) 
				=> //Calculate the difference in days of the start and end date that the user chooses.
			
			VAR Diff = 
				DATEDIFF(CurDate, PrevDate, DAY) //DAY | MONTH | YEAR
			
			RETURN
				Diff //return a numeric value of days
		```
	lineageTag: aae08c0e-daf1-4538-b32a-dd0f769835a5

function 'pbi.All_Sales0or1' = ```
		(ChangePct:decimal) 
				=>
		    
		        SWITCH(
		            TRUE(),
		            ChangePct > 0, 0,
		            ChangePct < 0, 1,
		            0
		        )
		```
