          <DataField>CountryRank</DataField>
        </Field>
        <Field Name="Top10Flag">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Top10Flag</DataField>
        </Field>
        <Field Name="AlbumArtist">
          <Value>=Fields!Album.Value &amp; "-" &amp; Fields!Artists.Value</Value>
        </Field>
