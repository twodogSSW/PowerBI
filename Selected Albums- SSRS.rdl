  <DataSets>
    <DataSet Name="ds_Sales">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Album">
            <Value>=Parameters!Album.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>/*
Declare @Album AS int = '112'
Declare @StartDate AS DATETIME = '2026-05-19'
Declare @EndDate AS DATETIME = '2026-06-29'; 
--*/

-- Step 1: Get DISTINCT album–artist pairs ONLY
WITH AlbumArtists AS (
    SELECT DISTINCT
        A.pkAlbum,
        A.Album,
        AR.Artist
    FROM Album A
    JOIN TrackList TL ON TL.fkAlbum = A.pkAlbum
    JOIN Artist AR ON AR.pkArtist = TL.fkArtist
    WHERE (A.pkAlbum IS NULL OR A.pkAlbum IN (@Album))
),

-- Step 2: Aggregate sales separately (so they don't multiply rows)
AlbumSalesAgg AS (
    SELECT 
        fkAlbum,
        SUM(SalesAmt) AS TotalSalesAmt,
        Salesdate,
        G.City,
        G.Country
    FROM AlbumSales
    LEFT JOIN Geography G ON G.pkGeography = AlbumSales.fkGeographyNo
    WHERE SalesDate BETWEEN @StartDate AND @EndDate
    GROUP BY fkAlbum, G.City, G.Country, SalesDate
),

-- ⭐ NEW: Total sales per country
CountryTotals AS (
    SELECT 
        Country,
        SUM(TotalSalesAmt) AS CountryTotalSales
    FROM AlbumSalesAgg
    WHERE Country IS NOT NULL
    GROUP BY Country
),

-- ⭐ NEW: Rank countries 1–N by total sales
CountryRanked AS (
    SELECT
        Country,
        CountryTotalSales,
        ROW_NUMBER() OVER (ORDER BY CountryTotalSales DESC) AS CountryRank
    FROM CountryTotals
)

-- Step 3: Final output
SELECT 
    AA.pkAlbum,
    AA.Album,
    STRING_AGG(CAST(AA.Artist AS NVARCHAR(MAX)), ', ')
        WITHIN GROUP (ORDER BY AA.Artist) AS Artists,
    COUNT(*) AS ArtistCount,
    CASE WHEN COUNT(*) &gt; 1 THEN 'Multiple' ELSE 'Single' END AS ArtistType,
    ASA.TotalSalesAmt,
    ASA.Salesdate,
    ASA.City,
    ASA.Country,

    -- ⭐ Add the country rank
    CR.CountryRank,

    -- ⭐ Add the Top 10 flag (0 = top 10, 1 = not)
    CASE WHEN CR.CountryRank &lt;= 10 THEN 0 ELSE 1 END AS Top10Flag

FROM AlbumArtists AA
LEFT JOIN AlbumSalesAgg ASA ON ASA.fkAlbum = AA.pkAlbum
LEFT JOIN CountryRanked CR ON CR.Country = ASA.Country
GROUP BY 
    AA.pkAlbum,
    AA.Album,
    ASA.TotalSalesAmt,
    ASA.Salesdate,
    ASA.City,
    ASA.Country,
    CR.CountryRank
ORDER BY 
    ASA.TotalSalesAmt DESC
    --CR.CountryRank,
    --AA.pkAlbum;</CommandText>
      </Query>
      <Fields>
        <Field Name="pkAlbum">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>pkAlbum</DataField>
        </Field>
        <Field Name="Album">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Album</DataField>
        </Field>
        <Field Name="Artists">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Artists</DataField>
        </Field>
        <Field Name="ArtistCount">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>ArtistCount</DataField>
        </Field>
        <Field Name="ArtistType">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ArtistType</DataField>
        </Field>
        <Field Name="TotalSalesAmt">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TotalSalesAmt</DataField>
        </Field>
        <Field Name="Salesdate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Salesdate</DataField>
        </Field>
        <Field Name="City">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>City</DataField>
        </Field>
        <Field Name="Country">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Country</DataField>
        </Field>
        <Field Name="CountryRank">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>CountryRank</DataField>
        </Field>
        <Field Name="Top10Flag">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Top10Flag</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ds_Album">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>Select 
	distinct a.pkAlbum, a.Album ,Sum(als.SalesAmt) as SalesAmt
from Album A
inner join albumSales ALS on als.fkAlbum = A.pkAlbum
Group by a.pkAlbum, a.Album
order by Album,SalesAmt</CommandText>
      </Query>
      <Fields>
        <Field Name="pkAlbum">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>pkAlbum</DataField>
        </Field>
        <Field Name="Album">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Album</DataField>
        </Field>
        <Field Name="SalesAmt">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>SalesAmt</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ds_Sales_Top10">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Album">
            <Value>=Parameters!Album.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>/*
Declare @Album AS int = '112'
Declare @StartDate AS DATETIME = '2026-05-19'
Declare @EndDate AS DATETIME = '2026-06-29'; 
--*/

-- Step 1: Get DISTINCT album–artist pairs ONLY
WITH AlbumArtists AS (
    SELECT DISTINCT
        A.pkAlbum,
        A.Album,
        AR.Artist
    FROM Album A
    JOIN TrackList TL ON TL.fkAlbum = A.pkAlbum
    JOIN Artist AR ON AR.pkArtist = TL.fkArtist
    WHERE (A.pkAlbum IS NULL OR A.pkAlbum IN (@Album))
),

-- Step 2: Aggregate sales separately (so they don't multiply rows)
AlbumSalesAgg AS (
    SELECT 
        fkAlbum,
        SUM(SalesAmt) AS TotalSalesAmt,
        Salesdate,
        G.City,
        G.Country
    FROM AlbumSales
    LEFT JOIN Geography G ON G.pkGeography = AlbumSales.fkGeographyNo
    WHERE SalesDate BETWEEN @StartDate AND @EndDate
    GROUP BY fkAlbum, G.City, G.Country, SalesDate
),

-- ⭐ NEW: Total sales per country
CountryTotals AS (
    SELECT 
        Country,
        SUM(TotalSalesAmt) AS CountryTotalSales
    FROM AlbumSalesAgg
    WHERE Country IS NOT NULL
    GROUP BY Country
),

-- ⭐ NEW: Rank countries 1–N by total sales
CountryRanked AS (
    SELECT
        Country,
        CountryTotalSales,
        ROW_NUMBER() OVER (ORDER BY CountryTotalSales DESC) AS CountryRank
    FROM CountryTotals
)

-- Step 3: Final output
SELECT 
    AA.pkAlbum,
    AA.Album,
    STRING_AGG(CAST(AA.Artist AS NVARCHAR(MAX)), ', ')
        WITHIN GROUP (ORDER BY AA.Artist) AS Artists,
    COUNT(*) AS ArtistCount,
    CASE WHEN COUNT(*) &gt; 1 THEN 'Multiple' ELSE 'Single' END AS ArtistType,
    ASA.TotalSalesAmt,
    ASA.Salesdate,
    ASA.City,
    ASA.Country,

    -- ⭐ Add the country rank
    CR.CountryRank,

    -- ⭐ Add the Top 10 flag (0 = top 10, 1 = not)
    CASE WHEN CR.CountryRank &lt;= 10 THEN 0 ELSE 1 END AS Top10Flag

FROM AlbumArtists AA
LEFT JOIN AlbumSalesAgg ASA ON ASA.fkAlbum = AA.pkAlbum
LEFT JOIN CountryRanked CR ON CR.Country = ASA.Country
Where CountryRank &lt;=10
GROUP BY 
    AA.pkAlbum,
    AA.Album,
    ASA.TotalSalesAmt,
    ASA.Salesdate,
    ASA.City,
    ASA.Country,
    CR.CountryRank
ORDER BY 
     Sum(ASA.TotalSalesAmt) DESC
    --CR.CountryRank,
    --AA.pkAlbum;</CommandText>
      </Query>
      <Fields>
        <Field Name="pkAlbum">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>pkAlbum</DataField>
        </Field>
        <Field Name="Album">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Album</DataField>
        </Field>
        <Field Name="Artists">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Artists</DataField>
