/// Table used to store Genre Descriptions (unique records)
table Genre
	lineageTag: b9f852f2-6409-4fd1-a9b3-d9ec35799f10

	/// pkGenre
	column pkGenre
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5fbffd60-6016-4e1c-bd0f-92a227dc1f3f
		summarizeBy: none
		sourceColumn: pkGenre

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Genre
	column Genre
		dataType: string
		lineageTag: 7c576fa2-3f30-4951-9aba-bc033ad9a19e
		summarizeBy: none
		sourceColumn: Genre

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition Genre = m
		mode: import
		source =
				let
				    Source = Sql.Database(ServerName, DBName, [Query="--only include active genres#(lf)SELECT  #(lf)    g.pkGenre,#(lf)    g.Genre #(lf)    --,Count(t.fkGenre) as CNT#(lf)FROM #(lf)    Genre g#(lf)inner join #(lf)    TrackList T on T.fkGenre = g.pkGenre#(lf)Group by g.pkGenre,g.Genre#(lf)Having Count(t.fkGenre)>=1#(lf)order by 2"]),
				    MarkedKeys = Table.AddKey(Source, {"pkGenre"}, true)
				in
				    MarkedKeys

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

