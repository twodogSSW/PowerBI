	/// Top10_Rank
	measure Top10_Rank = ```
			
			        SWITCH(
			            pbi.All_SelectedCategory(),
			            0, RANKX(ALLSELECTED(TrackList[Track - Artist]), [Sale #], , DESC, DENSE),
			            1, RANKX(ALLSELECTED(Genre[Genre]), [Sale #], , DESC, DENSE),
			            2, RANKX(ALLSELECTED(Artist[Artist]), [Sale #], , DESC, DENSE),
			            3, RANKX(ALLSELECTED(Album[Album]), [Sale #], , DESC, DENSE),
			            4, RANKX(ALLSELECTED(RecordLabel[RecordLabel]), [Sale #], , DESC, DENSE),
			            5, RANKX(ALLSELECTED(Region[Region]), [Sale #], , DESC, DENSE),
			            6, RANKX(ALLSELECTED(PurchasedFrom[PurchasedFrom]), [Sale #], , DESC, DENSE),
			            7, RANKX(ALLSELECTED(PurchasedFrom[Purchased From]), [Sale #], , DESC, DENSE),
			            BLANK()
			        )
			```
		formatString: 0
		displayFolder: _Top10Headers
		lineageTag: e22e0192-aea8-4024-8fae-97d042d2d1f7

	/// Top10_Title
	measure Top10_Title = ```
			
			    
			        SWITCH(
			            pbi.All_SelectedCategory(),
			            0, "📀🎶Top 10 Tracks: ",
			            1, "📚  Top 10 Genres: ",
			            2, "👩‍🎤  Top 10 Artists: ",
			            3, "💿  Top 10 Albums: ",
			            4, "📀  Top 10 Record Labels: ",
			            5, "🌍  Top 10 Regions: ",
			            6, "💸  Top 10 Retail Sale - Tracks: ",
			            7, "🏷️💸 Top 10 Retail Sale - Albums ",
			            "Other"  // Optional default if Field doesn't match any case
			        )
			```
		displayFolder: _Top10Headers
		lineageTag: e1a4fb0f-5fd4-425f-ac67-f5ba48134b9d

	/// Top10_SubTitle
	measure Top10_SubTitle = ```
			
			    VAR FieldSwitch =
			        SWITCH(
			            pbi.All_SelectedCategory(),
			            0, "📀🎶 $ by Track: ",
			            1, "📚 $ by Genre: ",
			            2, "👩‍🎤 $ by Artist: ",
			            3, "💿 $ by Album: ",
			            4, "📀 $ by Record Label: ",
			            5, "🌍 $ by Region: ",
			            6, "💸 $ by Retail Sale: - Tracks: ",
			            7, "🏷️💸 $ by Retail Sale: - Albums ",
			            "Other"  // Optional default if Field doesn't match any case
			        )
			
			    Return 
			        "Sales - " & 
			            FORMAT(MIN(Calendar[Date]), "MM/dd/yy") & " - " &
			            FORMAT(MAX(Calendar[Date]), "MM/dd/yy")
			```
		displayFolder: _Top10Headers
		lineageTag: 0d1429f0-abd9-48d0-8436-4e0d845856a2

