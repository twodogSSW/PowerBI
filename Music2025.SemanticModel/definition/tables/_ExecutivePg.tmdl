	measure Album%_Chg_LgBox_Narrative = ```
			
			    //Create the narrative used in the card visual
			    VAR Change = 
			        _ExecutivePg[Album%_Chg_LgBox]
			
			    RETURN
			        IF(
			            Change < 0,
			            "Album sales fell " & FORMAT(Change, "0%") & " vs same period last year.",
			            "Album sales rose " & FORMAT(Change, "0%") & " vs same period last year."
			        )
			```
		displayFolder: AlbumSectionLower
		lineageTag: 0e21e304-ba50-4830-9e47-76c6fd928968

	measure Album$_Chg% = ```
			
			    VAR PrevSales = 
			        pbi.ExecSumm_LowerSectionDolChangePrev(SUM(AlbumSales[SalesAmt]))
			    VAR CurSales = 
			        pbi.ExecSumm_LowerSectionDolChange(SUM(AlbumSales[SalesAmt]) )
			    VAR ChangePct = 
			        DIVIDE(CurSales, PrevSales, 0)
			
			    VAR Arrow = 
			        SWITCH
			            (
			                TRUE(),
			                ChangePct > 0, "▲ ",
			                ChangePct < 0, "▼ ",
			                "→ "
			            )
			            
			    RETURN
			        Arrow & FORMAT(ChangePct, "0.0%")
			```
		displayFolder: AlbumSectionLower
		lineageTag: c606d095-4aa4-4fe4-a2b1-43a3eae133ce

	measure Track$_Chg% = ```
			
			   VAR PrevSales = 
			        pbi.ExecSumm_LowerSectionDolChangePrev(SUM(TrackSales[SalesAmt]))
			    VAR CurSales = 
			        pbi.ExecSumm_LowerSectionDolChange(SUM(TrackSales[SalesAmt]) )
			    VAR ChangePct = 
			        DIVIDE(CurSales, PrevSales, 0)
			
			    VAR Arrow = 
			        SWITCH(
			            TRUE(),
			            ChangePct > 0, "▲ ",
			            ChangePct < 0, "▼ ",
			            "→ "
			        )
			
			RETURN
			    Arrow & FORMAT(ChangePct, "0.0%")
			```
		displayFolder: TrackSectionLower
		lineageTag: 89b73959-23f6-4fce-bbb1-9c26aace3853

