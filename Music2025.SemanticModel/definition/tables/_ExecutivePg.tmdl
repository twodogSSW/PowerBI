/// Only stuff used in Tab 2
table _ExecutivePg
	lineageTag: d300fb61-d09e-4024-b31c-4dbc23236ad7

	measure Album$_Prev = ```
			
			    --the previous amount based on time period
			    pbi.ExecSumm_LowerSectionDolChangePrev(SUM(AlbumSales[SalesAmt]))
			  
			```
		displayFolder: AlbumSectionLower
		lineageTag: 7955f0fc-360a-47b2-8ae8-c209af3e488a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Album%_Chg_LgBox = ```
			
			    DIVIDE(
			        pbi.ExecSumm_LowerSectionDolChange(SUM(AlbumSales[SalesAmt])),
			        CALCULATE(
			            SUM(AlbumSales[SalesAmt]),
			            SAMEPERIODLASTYEAR(ALLSELECTED(Calendar[Date]))
			        ),
			        0
			    )
			```
		displayFolder: AlbumSectionLower
		lineageTag: eb28b361-0e29-49f6-be36-ab9b698c4496

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Album$_Diff = ```
			
			   --change between this time and prev time period
			   pbi.ExecSumm_LowerSectionDolChange(SUM(AlbumSales[SalesAmt]) )
			```
		displayFolder: AlbumSectionLower
		lineageTag: 0e5f4b9a-289f-44e5-a070-4ad1cd84b97f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Album$_PosOrNeg = ```
			
			    VAR PosOrNeg = 
			        pbi.ExecSumm_LowerSectionDolChange(SUM(AlbumSales[SalesAmt]) )
			    RETURN
			        pbi.All_Sales0or1(PosOrNeg)
			           
			```
		formatString: 0
		displayFolder: AlbumSectionLower
		lineageTag: f3ab0e9a-3784-47fa-b06f-7ba7df57eec7

