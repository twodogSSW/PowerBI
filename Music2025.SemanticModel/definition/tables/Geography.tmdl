table Geography
	lineageTag: 9022b6a0-cca9-4059-8f0f-e5d82dd25af6

	measure Selected$ = ```
			
			SWITCH(
			  TRUE(),
			  HASONEFILTER( TrackList[Track - Artist] ),
			    SUM( TrackSales[SalesAmt] ),
			  HASONEFILTER( Album[Album]),
			    SUM( AlbumSales[SalesAmt] ),
			  // Default if nothing picked
			  SUM( TrackSales[SalesAmt] )
			)
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 225b506c-e2f1-4e28-a469-13c4c6597e33

		changedProperty = IsHidden

	measure Selected$_Region = ```
			
			SWITCH(
			  TRUE(),
			  HASONEFILTER( TrackList[Track - Artist] ),
			    "Track Sales - by Region",
			  HASONEFILTER( Album[Album]),
			    "Album Sales - By Region",
			  // Default if nothing picked
			  "Track Sales by Region")
			
			
			```
		lineageTag: 69e001e0-be13-4407-ba72-34623513c60d

		changedProperty = IsHidden

	measure Selected$_CountryCity =
			
			SWITCH(
			  TRUE(),
			  HASONEFILTER( TrackList[Track - Artist] ),
			    "Track Sales by Country/City",
			  HASONEFILTER( Album[Album]),
			    "Album Sales by Country/City",
			  // Default if nothing picked
			  "Track Sales by Country/City")
		lineageTag: 1031d399-9e72-4419-bdd6-de1bbb9c24c6

		changedProperty = IsHidden

