	partition Geography = m
		mode: import
		source =
				let
				    Source = Sql.Database(ServerName, DBName, [Query="SELECT #(lf)     [pkGeography]#(lf)      ,[fkRegion]#(lf)      ,[City]#(lf)      ,[State]#(lf)      ,[Province]#(lf)      ,[Country]#(lf)      ,[Continent]#(lf)      ,[latitude]#(lf)      ,[longitude]#(lf)  FROM #(lf)     [Music2024].[dbo].[Geography]#(lf)", CommandTimeout=#duration(0, 0, 10, 0)]),
				    MarkedKeys = Table.AddKey(Source, {"pkGeography"}, true)
				in
				    MarkedKeys

