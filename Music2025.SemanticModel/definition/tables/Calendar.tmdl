	measure 'ExecSumm Header' = ```
			
			VAR sd  = format('Calendar'[StartDate], "mm/dd/yy")   
			VAR ed  = format('Calendar'[EndDate], "mm/dd/yy")   
			
			Return
			    "30/60/90-day changes are from today; section below uses selected range of ("
			    & sd & " to " & ed & ")"
			```
		displayFolder: HeadersFooters
		lineageTag: ac664ad7-cba0-4bfb-9e64-50401750dc4b

	measure StartDate_prm = ```
			
			VAR dt =
			    CALCULATE(
			      MIN( 'Calendar'[Date] ),
			      KEEPFILTERS( ALLSELECTED( 'Calendar' ) )
			    )
			RETURN
			  "rp:StartDate="
			    & FORMAT( dt, "yyyy-MM-dd" )
			    & "%20"
			    & FORMAT( dt, "HH:mm:ss.0" )
			
			```
		displayFolder: HeadersFooters
		lineageTag: dfcf4568-73ba-46fb-8f97-7de84ce32dcd

	measure EndDate_prm =
			
			//end date parameter
			VAR dt =
			    CALCULATE(
			      MAX( 'Calendar'[Date] ),
			      KEEPFILTERS( ALLSELECTED( 'Calendar' ) )
			    )
			RETURN
			  "rp:EndDate="
			    & FORMAT( dt, "yyyy-MM-dd" )
			    & "%20"
			    & FORMAT( dt, "HH:mm:ss.0" )
