table Calendar
	lineageTag: fca5410b-58b9-40bf-8964-2a1c781ac37d
	dataCategory: Time

	measure AlbumSales_Footer = ```
			
			    --Date range of the data used in this measure
			    Var MinDate = Format(Min('AlbumSales'[Salesdate]),"mm/dd/yy")
			    Var MaxDate = Format(Max('AlbumSales'[Salesdate]),"mm/dd/yy")
			    VAR DateRange = " Album Sales between " & MinDate & " and " & MaxDate
			Return 
			    DateRange
			```
		displayFolder: HeadersFooters
		lineageTag: cc2b8515-a2ca-423a-bb3b-753f46e87e4d

	measure Date_Footer = ```
			
			    'Calendar'[AlbumSales_Footer] & " - " & 'Calendar'[TrackSales_Footer]   
			```
		displayFolder: HeadersFooters
		lineageTag: d14eed32-6deb-4d69-80ea-f6bb264558ae

	measure TrackSales_Footer = ```
			
			    --Date range of the data used in this measure
			    Var MinDate = Format(Min('AlbumSales'[Salesdate]),"mm/dd/yy")
			    Var MaxDate = Format(Max('AlbumSales'[Salesdate]),"mm/dd/yy")
			    VAR DateRange = " Track Sales between " & MinDate & " and " & MaxDate
			Return 
			    DateRange
			```
		displayFolder: HeadersFooters
		lineageTag: 8612a778-1e92-4c20-9399-1b150b1c1eb6

	measure LastRefreshDate = "Data refreshed as of " &format(now(),"mm/dd/yy")
		lineageTag: 4681f705-de51-47fa-b5ce-775176e241f3

	measure StartDate = ```
			
			    CALCULATE(
			      MIN( 'Calendar'[Date] ),
			      KEEPFILTERS( ALLSELECTED( 'Calendar' ) )
			    )
			
			```
		formatString: General Date
		displayFolder: HeadersFooters
		lineageTag: 08037acc-916f-4e8a-ae86-c49ad5291858

