	partition Calendar = calculated
		mode: import
		source = ```
				
				VAR MinDate = MIN( TrackSales[SalesDate] )
				VAR MaxDate = MAX( TrackSales[SalesDate] )
				VAR StartOfFiscalYear = 7
				VAR ShiftMonths = 13 - StartOfFiscalYear
				VAR AdjShift =
				    IF( ShiftMonths >= 12 || ShiftMonths < 0, 0, ShiftMonths )
				RETURN
				ADDCOLUMNS(
				    CALENDAR( MinDate, MaxDate ),
				    
				    // Standard date parts
				    "Year",            YEAR( [Date] ),
				    "Start of Year",   DATE( YEAR([Date]), 1, 1 ),
				    "End of Year",     DATE( YEAR([Date]), 12, 31 ),
				    "Month",           MONTH( [Date] ),
				    "Start of Month",  DATE( YEAR([Date]), MONTH([Date]), 1 ),
				    "End of Month",    EOMONTH( [Date], 0 ),
				    "Days in Month",   DAY( EOMONTH( [Date], 0 ) ),
				    "Day",             DAY( [Date] ),
				    "Day Name",        FORMAT( [Date], "dddd" ),
				    "Day of Week",     WEEKDAY( [Date], 1 ) - 1,                // Sunday=0…Saturday=6
				    "Day of Year",     DATEDIFF( DATE( YEAR([Date]),1,1 ), [Date], DAY ) + 1,
				    "Month Name",      FORMAT( [Date], "MMMM" ),
				    "Quarter",         QUARTER( [Date] ),
				    "Start of Quarter",
				       DATE(
				         YEAR([Date]),
				         ( QUARTER([Date]) - 1 ) * 3 + 1,
				         1
				       ),
				    "End of Quarter",
				       EOMONTH(
				         DATE(
				           YEAR([Date]),
				           ( QUARTER([Date]) - 1 ) * 3 + 1,
				           1
				         ),
				         2
				       ),
				    
				    // ISO-ish week calculation with Monday as first day
				    "Week of Year",    WEEKNUM( [Date], 2 ),
				    "Week of Month",
				      WEEKNUM( [Date], 2 )
				      - WEEKNUM(
				          DATE( YEAR([Date]), MONTH([Date]), 1 ),
				          2
				        )
				      + 1,
				    "Start of Week",   [Date] - WEEKDAY( [Date], 2 ) + 1,      // Monday of that week
				    "End of Week",     [Date] + ( 7 - WEEKDAY( [Date], 2 ) ),
				    
				// Fiscal year/quarter/month based on StartOfFiscalYear
				/*
				    "Fiscal Year",     YEAR( EDATE( [Date], AdjShift ) ),
				    "Fiscal Quarter",  QUARTER( EDATE( [Date], AdjShift ) ),
				    "Fiscal Month",    MONTH( EDATE( [Date], AdjShift ) ),
				 --*/   
				
				// Offsets relative to Today()
				/*
				    "Day Offset",      DATEDIFF( TODAY(), [Date], DAY ),
				    "Month Offset",
				      ( YEAR([Date]) - YEAR( TODAY() ) ) * 12
				      + ( MONTH([Date]) - MONTH( TODAY() ) ),
				    "Year Offset",     YEAR([Date]) - YEAR( TODAY() ),
				    "Quarter Offset",
				      ( YEAR([Date]) - YEAR( TODAY() ) ) * 4
				      + ( QUARTER([Date]) - QUARTER( TODAY() ) ),
				--*/
				
				    // Text & business‐day flags
				    "ShortMonth",      LEFT( FORMAT([Date],"MMMM"), 3 ),
				    "YearShortMonth",  LEFT( FORMAT([Date],"MMMM"), 3 ) & " " & YEAR([Date])
				 //   ,"BusinessDay",
				//      IF( WEEKDAY( [Date], 2 ) < 6, TRUE(), FALSE() )
				)
				
				
				```

	annotation PBI_Id = 41ce0e2d914346b0800dc948ff924234

