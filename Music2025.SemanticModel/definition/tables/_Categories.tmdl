	measure TooltipText = ```
			
			    //0 - Title | 1  Genre | 2 - Artist | 3- Album | 4-RecordLabel | 5-Region | 6-Retailer (tracks) | 7 - Retailer (albums)
			
			    //populates the tooltip page
			    VAR Selected = _Categories[SelectedSales]
			    VAR Ranking = _Categories[SalesRank]
			    VAR CNT = _Categories[CountRows_All]
			    VAR MAXSales = _Categories[MaxSales_Gauge]
			    VAR Pct = DIVIDE(Selected, MAXSales, 0)
			    VAR Percentile = DIVIDE(Ranking, CNT, 1)
			
			    -- 🏷️ Selected Label
			    VAR Label =
			        SWITCH(
			            SELECTEDVALUE(_Categories[Category Order], -1),
			            0, SELECTEDVALUE(TrackList[Title]),
			            1, SELECTEDVALUE(Genre[Genre]),
			            2, SELECTEDVALUE(Artist[Artist]),
			            3, SELECTEDVALUE(Album[Album]),
			            4, SELECTEDVALUE(RecordLabel[RecordLabel]),
			            5, SELECTEDVALUE(Region[Region]),
			            6, SELECTEDVALUE(PurchasedFrom[PurchasedFrom]),
			            7, SELECTEDVALUE(PurchasedFrom[PurchasedFrom]),
			            BLANK()
			        )
			
			    VAR NoSelection = ISBLANK(Label)
			
			    -- 🟢🟡🟠🔴 Icon by Percentile
			    VAR Icon =
			        SWITCH(
			            TRUE(),
			            Percentile = DIVIDE(1, CNT, 0), UNICHAR(128994),  // 🟢 Top 1
			            Percentile <= 0.10, UNICHAR(129001),              // 🟢🟢 Light green
			            Percentile <= 0.50, UNICHAR(128993),              // 🟡 Yellow
			            Percentile <= 0.75, UNICHAR(128992),              // 🟠 Orange
			            Percentile > 0.75, UNICHAR(128308)                // 🔴 Red
			        )
			
			    -- 🏆 Badge for Top Seller
			    VAR Badge = IF(Ranking = 1, UNICHAR(127942) & " Top Seller", BLANK())
			
			    -- 🧠 Narrative Summary
			    VAR Narrative =
			        "This item ranks #" & Ranking & " of " & FORMAT(CNT, "#,##0")--CNT
			        & ", placing it in the top " & FORMAT(Percentile * 100, "0.0") & "% of the category."
			
			    -- ⚠️ Fallback Message
			    VAR Fallback =
			        "⚠️ No record selected. Please choose at least one record from the table to view $ details."
			
			    RETURN
			    IF(
			        NoSelection,
			        Fallback,
			        Icon & " " & Label
			        & UNICHAR(10) & "Sales: $" & FORMAT(Selected, "#,##0")
			        & UNICHAR(10) & "% to Max: " & FORMAT(Pct, "0.0%")
			        & UNICHAR(10) & Narrative
			        & IF(NOT(ISBLANK(Badge)), UNICHAR(10) & Badge)
			    )
			
			```
		displayFolder: KPIText
		lineageTag: e0b6fdfc-f570-4fff-88a2-7784f66e6c6f

