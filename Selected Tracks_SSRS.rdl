  <ReportParameters>
    <ReportParameter Name="pArtist">
      <DataType>Integer</DataType>
      <Prompt>Select one or more Artists</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>ds_Artists</DataSetName>
          <ValueField>pkArtist</ValueField>
          <LabelField>Artist</LabelField>
        </DataSetReference>
      </ValidValues>
      <MultiValue>true</MultiValue>
      <cl:ComponentMetadata>
        <cl:HideUpdateNotifications>true</cl:HideUpdateNotifications>
      </cl:ComponentMetadata>
    </ReportParameter>
    <ReportParameter Name="pTrack">
      <DataType>Integer</DataType>
      <Prompt>Choose Tracks</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>ds_Tracks</DataSetName>
          <ValueField>pkTrackList</ValueField>
          <LabelField>TrackLabel</LabelField>
        </DataSetReference>
      </ValidValues>
      <MultiValue>true</MultiValue>
      <cl:ComponentMetadata>
        <cl:HideUpdateNotifications>true</cl:HideUpdateNotifications>
      </cl:ComponentMetadata>
    </ReportParameter>
    <ReportParameter Name="StartDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=DateSerial(Year(Today()), Month(Today()), 1)</Value>
        </Values>
      </DefaultValue>
      <Prompt>Choose Starting Date</Prompt>
      <cl:ComponentMetadata>
        <cl:HideUpdateNotifications>true</cl:HideUpdateNotifications>
      </cl:ComponentMetadata>
    </ReportParameter>
    <ReportParameter Name="EndDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=DateSerial(Year(Today()), Month(Today()) + 1, 0)</Value>
        </Values>
      </DefaultValue>
      <Prompt>Choose Ending Date</Prompt>
      <cl:ComponentMetadata>
        <cl:HideUpdateNotifications>true</cl:HideUpdateNotifications>
      </cl:ComponentMetadata>
    </ReportParameter>
  </ReportParameters>
