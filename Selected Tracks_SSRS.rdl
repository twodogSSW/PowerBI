  <DataSources>
    <DataSource Name="DSMusic">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=STDESKTOP\MSSQLSERVER02;Initial Catalog=Music2024</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>58cea85f-2099-484e-8ee1-b0ee71ad5ba8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DS_TrackSales">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pTrack">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!pTrack.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pArtist">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!pArtist.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT
    t.pkTrackList,
    t.Title,
    a.Artist,    
    g.Genre,
    al.Album,
    t.Year,
    t.length_sec,
    t.Composer,
    ts.Salesdate,
    ts.SaleCount,
    ts.SalesAmt
FROM 
    dbo.TrackList AS t
LEFT JOIN 
    dbo.Artist     AS a  ON t.fkArtist      = a.pkArtist
LEFT JOIN 
    dbo.Genre      AS g  ON t.fkGenre       = g.pkGenre
LEFT JOIN 
    dbo.TrackSales AS ts ON t.pkTrackList   = ts.fkTrackList
LEFT JOIN 
    dbo.Album      AS al ON t.fkAlbum       = al.pkAlbum
WHERE
      
    t.fkArtist IN (@pArtist)
   AND 
    t.pkTrackList IN (@pTrack)
 AND 
    (@StartDate IS NULL OR ts.Salesdate &gt;= @StartDate)
  AND 
    (@EndDate   IS NULL OR ts.Salesdate &lt;= @EndDate)

order by SalesAmt Desc</CommandText>
      </Query>
      <Fields>
        <Field Name="pkTrackList">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>pkTrackList</DataField>
        </Field>
        <Field Name="Title">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Title</DataField>
        </Field>
        <Field Name="Year">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Year</DataField>
        </Field>
        <Field Name="length_sec">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>length_sec</DataField>
        </Field>
        <Field Name="Album">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Album</DataField>
        </Field>
        <Field Name="Composer">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Composer</DataField>
        </Field>
        <Field Name="Artist">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Artist</DataField>
        </Field>
        <Field Name="Genre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Genre</DataField>
        </Field>
        <Field Name="Salesdate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Salesdate</DataField>
        </Field>
        <Field Name="SaleCount">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>SaleCount</DataField>
        </Field>
        <Field Name="SalesAmt">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>SalesAmt</DataField>
        </Field>
        <Field Name="ArtistTrack">
          <Value>= Fields!Artist.Value &amp; "-" &amp; Fields!Title.Value</Value>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ds_Artists">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT pkArtist, Artist
FROM dbo.Artist
ORDER BY Artist</CommandText>
      </Query>
      <Fields>
        <Field Name="pkArtist">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>pkArtist</DataField>
        </Field>
        <Field Name="Artist">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Artist</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ds_Tracks">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@pArtist">
            <Value>=Parameters!pArtist.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT 
    
      t.pkTrackList,
    
      t.Title,
    
      a.Artist

FROM dbo.TrackList t

      JOIN dbo.Artist a ON t.fkArtist = a.pkArtist

WHERE 
      t.fkArtist IN (@pArtist)

ORDER BY 
      a.Artist, t.Title</CommandText>
      </Query>
      <Fields>
        <Field Name="pkTrackList">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>pkTrackList</DataField>
        </Field>
        <Field Name="Title">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Title</DataField>
        </Field>
        <Field Name="Artist">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Artist</DataField>
        </Field>
        <Field Name="TrackLabel">
          <Value>=IIF(UBound(Parameters!pArtist.Value) = 0,
     Fields!Title.Value,
     Fields!Artist.Value &amp; " – " &amp; Fields!Title.Value)</Value>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
