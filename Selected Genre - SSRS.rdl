        </Values>
      </DefaultValue>
      <Prompt>Choose Starting Date</Prompt>
      <cl:ComponentMetadata>
        <cl:HideUpdateNotifications>true</cl:HideUpdateNotifications>
      </cl:ComponentMetadata>
    </ReportParameter>
    <ReportParameter Name="EndDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=DateSerial(Year(Today()), Month(Today()) + 1, 0)</Value>
        </Values>
      </DefaultValue>
      <Prompt>Choose Ending Date</Prompt>
      <cl:ComponentMetadata>
        <cl:HideUpdateNotifications>true</cl:HideUpdateNotifications>
      </cl:ComponentMetadata>
    </ReportParameter>
    <ReportParameter Name="pGenre">
      <DataType>Integer</DataType>
      <Prompt>Genre</Prompt>
