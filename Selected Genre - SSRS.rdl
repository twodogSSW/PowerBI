  <DataSources>
    <DataSource Name="DSMusic">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=STDESKTOP\MSSQLSERVER02;Initial Catalog=Music2024</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>58cea85f-2099-484e-8ee1-b0ee71ad5ba8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsSales">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@pGenre">
            <Value>=Parameters!pGenre.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>/*
Declare @Artists AS int = '20'
Declare @StartDate AS DATETIME = '2025-01-01'
Declare @EndDate AS DATETIME = '2025-12-31'; 
--*/

SELECT
      t.fkGenre,
      a.Artist,      
      t.Title,
      t.Composer,
      g.Genre,
      al.Album,
      ts.Salesdate,
      ts.SalesAmt
FROM 
      dbo.TrackList AS t
LEFT JOIN 
     dbo.Artist a       ON t.fkArtist  = a.pkArtist
LEFT JOIN 
      dbo.Genre g       ON t.fkGenre       = g.pkGenre
LEFT JOIN 
      dbo.TrackSales ts ON t.pkTrackList   = ts.fkTrackList
LEFT JOIN 
      dbo.Album al ON al.pkAlbum   = t.fkAlbum
WHERE
    (G.pkGenre IS NULL OR G.pkGenre IN (@pGenre))
    AND (@StartDate IS NULL OR ts.Salesdate &gt;= @StartDate)
    AND (@EndDate IS NULL OR ts.Salesdate &lt;= @EndDate)</CommandText>
      </Query>
      <Fields>
        <Field Name="fkGenre">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>fkGenre</DataField>
        </Field>
        <Field Name="Artist">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Artist</DataField>
        </Field>
        <Field Name="Title">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Title</DataField>
        </Field>
        <Field Name="Composer">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Composer</DataField>
        </Field>
        <Field Name="Genre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Genre</DataField>
        </Field>
        <Field Name="Album">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Album</DataField>
        </Field>
        <Field Name="Salesdate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Salesdate</DataField>
        </Field>
        <Field Name="SalesAmt">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>SalesAmt</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsGenre">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>--only show Genre where there's at least one record in tracklist that uses it.
Select distinct 
	G.pkGenre,Genre
from 
	Genre G
inner join 
	TrackList T on T.fkGenre = G.pkGenre
Order by G.Genre</CommandText>
      </Query>
      <Fields>
        <Field Name="pkGenre">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>pkGenre</DataField>
        </Field>
        <Field Name="Genre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Genre</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsArtists">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <CommandText>--only show Genre where there's at least one record in tracklist that uses it.
Select distinct 
	A.pkArtist,Artist
from 
	Artist A
inner join 
	TrackList T on T.fkArtist = A.pkArtist
Order by A.Artist</CommandText>
      </Query>
      <Fields>
        <Field Name="pkArtist">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>pkArtist</DataField>
        </Field>
        <Field Name="Artist">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Artist</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
