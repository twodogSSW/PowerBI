	column URLHardcoded
		dataType: string
		lineageTag: 35a0bae2-cf04-4e3d-a608-a664a264c634
		dataCategory: WebUrl
		summarizeBy: none
		sourceColumn: URLHardcoded

		annotation SummarizationSetBy = Automatic

	partition Artist = m
		mode: import
		source =
				let
				    Source = Sql.Database(ServerName, DBName, [Query="SELECT #(lf)     pkArtist,#(lf)     Artist,#(lf)     fkRecordLabel,#(lf)     URLHardcoded#(lf)FROM #(lf)   [Artist]", CommandTimeout=#duration(0, 0, 10, 0)]),
				
				    // Optional: CleanArtist (kept for future use, not needed for Wikipedia)
				    CleanArtist = Table.AddColumn(Source, "CleanArtist", each
				        let
				            Artist = [Artist],
				            ReplacedAmp = Text.Replace(Artist, "&", "and"),
				            Allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789",
				            Clean =
				                Text.Combine(
				                    List.Select(
				                        Text.ToList(ReplacedAmp),
				                        each Text.Contains(Allowed, _)
				                    )
				                )
				        in
				            Clean
				    ),
				
				    // Wikipedia URL builder
				    ArtistURL = Table.AddColumn(CleanArtist, "ArtistURL", each
				        let
				            ArtistName = [Artist],
				
				            // Replace spaces with underscores
				            Step1 = Text.Replace(ArtistName, " ", "_"),
				
				            // Replace & with "and"
				            Step2 = Text.Replace(Step1, "&", "and"),
				
				            // Replace ? with %3F (URL encoding)
				            Step3 = Text.Replace(Step2, "?", "%3F")
				
				        in
				            "https://en.wikipedia.org/wiki/" & Step3
				    ),
				
				    // Homepage URL builder (strip all non-alphanumeric)
				    HomePageURL = Table.AddColumn(ArtistURL, "HomePageURL", each
				        let
				            Artist = [Artist],
				            Allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789",
				            Clean =
				                Text.Combine(
				                    List.Select(
				                        Text.ToList(Artist),
				                        each Text.Contains(Allowed, _)
				                    )
				                ),
				            URL = "https://www." & Clean & ".com"
				        in
				            URL
				    ),
				
				    MarkedKeys = Table.AddKey(HomePageURL, {"pkArtist"}, true),
				    #"Changed Type" = Table.TransformColumnTypes(MarkedKeys,{{"ArtistURL", type text}, {"HomePageURL", type text}}),
				
				    // Remove CleanArtist if you don't want it in the model
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"CleanArtist"}),
				    #"Filtered Rows" = Table.SelectRows(#"Removed Columns", each true),
				    #"Reordered Columns" = Table.ReorderColumns(#"Filtered Rows",{"pkArtist", "Artist", "fkRecordLabel", "ArtistURL", "HomePageURL", "URLHardcoded"})
				in
				    #"Reordered Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

