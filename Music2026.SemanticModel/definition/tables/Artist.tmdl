/// Table used to store Artist/Recording group information (unique records)
table Artist
	lineageTag: d5807c9a-cb2e-4798-b4ed-7970fdfd26e2

	measure SelectedWikiURL = ```
			
			    VAR ArtistName =
			        SELECTEDVALUE(Artist[Artist])
			
			    VAR HasArtist =
			        NOT ISBLANK(ArtistName)
			
			    VAR MainURL =
			        SELECTEDVALUE(Artist[ArtistURL])
			
			    RETURN
			    IF(
			        HasArtist,
			            IF(
			                NOT ISBLANK(MainURL),
			                MainURL,
			                "https://en.wikipedia.org/wiki/" &
			                    SUBSTITUTE(ArtistName, " ", "_")
			            ),
			        BLANK()
			    )
			
			```
		lineageTag: c631595a-32d8-400c-9ece-7f78c7f3e43c

	measure SelectedHomePageURL = ```
			
			    VAR Hardcoded =
			        SELECTEDVALUE(Artist[URLHardcoded])
			
			    VAR HomeURL =
			        SELECTEDVALUE(Artist[HomePageURL])
			
			    VAR ArtistURL =
			        SELECTEDVALUE(Artist[ArtistURL])
			
			    RETURN
			    IF(
			        NOT ISBLANK(Hardcoded),
			            Hardcoded,                      -- Priority 1
			            IF(
			                NOT ISBLANK(HomeURL),
			                    HomeURL,                -- Priority 2
			                    ArtistURL               -- Priority 3
			            )
			    )
			```
		lineageTag: 1cdfa948-4fee-466b-af35-4e15c462b3b1

	measure SelectedWikiURLTooltip =
			
			VAR ArtistName =
			    SELECTEDVALUE(Artist[Artist])
			RETURN
			IF(
			    NOT ISBLANK(ArtistName),
			    "Connect to " & ArtistName & "'s Wikipedia page",
			    "Click on the Artist Category and an artist, to see their wikipedia page"
			)
		lineageTag: 6adcd392-217e-407a-bd19-5a84300db3e9

	measure SelectedHomePageTooltip =
			
			VAR ArtistName =
			    SELECTEDVALUE(Artist[Artist])
			RETURN
			IF(
			    NOT ISBLANK(ArtistName),
			    "Connect to " & ArtistName & "'s Home page",
			    "Click on the Artist Category and an artist, to see their home page"
			)
		lineageTag: e5910028-212c-441f-9889-46f701f519d7

	measure IsAlbumCategory = ```
			
			    --2 is the artist category - Artist category order
			    VAR 
			        SelectedCat = SELECTEDVALUE(_Categories[Category Order])
			    RETURN 
			        IF(SelectedCat = 3, --if artist is selected
			        1, 0)               --true else false
			    
			```
		formatString: 0
		lineageTag: 63d52266-d549-449a-ba30-f8e4e19626e3

	measure FillColor = ```
			
			IF(
			    [IsArtistCategory] = 0,
			    "#1090FF",        -- or whatever your normal button color is
			    "#FFFFFF00"       -- transparent (ARGB)
			)
			
			```
		lineageTag: 69c47464-6bfe-4440-86b4-c3c46d79dee7

	measure IsArtistCategory = ```
			
			    --2 is the artist category - Artist category order
			    VAR 
			        SelectedCat = SELECTEDVALUE(_Categories[Category Order])
			    RETURN 
			        IF(SelectedCat = 2, --if artist is selected
			        1, 0)               --true else false
			```
		formatString: 0
		lineageTag: 6a0e6838-6832-45c0-b7ce-735f2ae88a5d

