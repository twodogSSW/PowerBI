	partition TrackSales = m
		mode: import
		source = ```
				let    
				    Source = Sql.Database(ServerName, DBName, [CommandTimeout=#duration(0, 1, 0, 0), Query="SELECT #(lf)    [pkTrackSales]#(lf)    ,[fkTrackList]#(lf)    ,[fkGeographyNo]#(lf)    ,[Salesdate]#(lf)    ,[SaleCount]#(lf)    ,[SalesAmt]#(lf)    ,[fkPurchasedFrom]#(lf)    --,[Include]#(lf)    ,[CC]#(lf)    ,[Bitcoin]#(lf)    ,Cash#(lf)  FROM #(lf)    [dbo].[TrackSales]#(lf)--where [Salesdate] >= '11/1/2024 12:00:00 AM'"]),
				    MarkedKeys = Table.AddKey(Source, {"pkTrackSales"}, true)
				in
				    MarkedKeys
				```

