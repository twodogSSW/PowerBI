	/// Continent
	column Continent
		dataType: string
		lineageTag: 63f7e7d4-f361-4f5f-b128-27f6b808b3dc
		dataCategory: Continent
		summarizeBy: none
		sourceColumn: Continent

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column pkGeography
		dataType: int64
		formatString: 0
