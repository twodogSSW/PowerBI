/// Table used to store Geographic details Descriptions (unique records)
table Geography
	lineageTag: 9022b6a0-cca9-4059-8f0f-e5d82dd25af6

	/// Selected
	measure Selected$ = ```
			
			SWITCH(
			  TRUE(),
			  HASONEFILTER( TrackList[Artist - Track] ),
			    SUM( TrackSales[SalesAmt] ),
			  HASONEFILTER( 'Album'[Album]),
			    SUM( AlbumSales[SalesAmt] ),
			  // Default if nothing picked
			  SUM( TrackSales[SalesAmt] )
			)
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 225b506c-e2f1-4e28-a469-13c4c6597e33

		changedProperty = IsHidden

	/// City
	column City
		dataType: string
		lineageTag: 38e966eb-b720-463c-8816-c5006fd3becf
		dataCategory: City
		summarizeBy: none
		sourceColumn: City

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// State
	column State
		dataType: string
		lineageTag: a3e1b6c7-11ef-4fe9-a6f5-ef05816ff808
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: State

		changedProperty = IsHidden

