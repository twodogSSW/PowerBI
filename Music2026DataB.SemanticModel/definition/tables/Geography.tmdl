	partition Geography = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs("dbc-889876c1-2aee.cloud.databricks.com", "/sql/1.0/warehouses/4a6aab97cf7a86de", [Catalog=null, Database=null, QueryTags=null, EnableAutomaticProxyDiscovery=null, Implementation="2.0", Protocol=null]),
				    workspace_Database = Source{[Name="workspace",Kind="Database"]}[Data],
				    music_gold_Schema = workspace_Database{[Name="music_gold",Kind="Schema"]}[Data],
				    dim_geography_Table = music_gold_Schema{[Name="dim_geography",Kind="Table"]}[Data],
				    #"Removed Columns" = Table.RemoveColumns(dim_geography_Table,{"CityPopulation", "FileDate", "ModDate", "latitude", "longitude", "skGeography"})
				in
