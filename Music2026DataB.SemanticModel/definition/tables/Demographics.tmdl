/// Table used to store Demographics of each Track (popularity among age groups)
table Demographics
	lineageTag: 58a39f59-d175-4288-aab3-a5ca8fdc0867

	/// DemoCount_Selected
	measure DemoCount_Selected = ```
			
			
			IF(
			    HASONEVALUE(Demographics[Demographic]),
			    SUM(Demographics[DemoCount]),
			    BLANK()  // or 0, or "Multiple selected"
			)
			
			```
		formatString: 0
		lineageTag: 1e0153b6-9e22-44f6-8c22-3b95cffb8516

		changedProperty = IsHidden

	/// DemoCountM
	measure DemoCountM = ```
			
			    SUM(Demographics[DemoCount])
			
			
			```
		formatString: 0
		lineageTag: 708aebfa-6e34-4650-b31d-37398f6a75d6

		changedProperty = IsHidden

	/// DemoCount_Tornado
	measure DemoCount_Tornado =
			
			VAR Gender = SELECTEDVALUE(Demographics[Gender])
			VAR CountM = Demographics[DemoCountM]
			RETURN
			IF(Gender = "Male", -CountM, CountM)
		formatString: #,0
		lineageTag: 18928e72-1e34-4255-a681-0f7f589705b6

		changedProperty = IsHidden

	/// DynamicDemoCount
	measure DynamicDemo_Count =
			
			VAR SelCount = COUNTROWS( VALUES( 'TrackList'[Artist - Track] ) )
			VAR ThisValue = Demographics[DemoCount_Tornado]
			VAR AvgAll = CALCULATE(
			    AVERAGEX(
			        VALUES( 'TrackList'[Artist - Track] ),
			        Demographics[DemoCount_Tornado]
			    ),
			    ALL( 'TrackList'[Artist - Track] )
			)
			VAR AvgSelected = AVERAGEX(
			    VALUES( 'TrackList'[Artist - Track] ),
			    Demographics[DemoCount_Tornado]
			)
			VAR Result = SWITCH(
			    TRUE(),
			    SelCount = 0, AvgAll,
			    SelCount = 1, ThisValue,
			    SelCount > 1, AvgSelected,
			    BLANK()
			)
			RETURN
			    IF(Result = 0, BLANK(), Result)
		lineageTag: ea0e1738-0cf5-4e62-8db4-96d17a5dfec7

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Demographic
	column Demographic
		dataType: string
		lineageTag: 16e19e4d-3104-4938-befb-8ce7b4bfafb0
		summarizeBy: none
		sourceColumn: Demographic

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// DemoCount
	column DemoCount
		dataType: int64
		formatString: 0
		lineageTag: 70fe3e6a-13f6-4b5b-8345-ef40a728c454
		summarizeBy: sum
		sourceColumn: DemoCount

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Gender
	column Gender =
			
			IF(
			    LEFT(Demographics[Demographic], 1) = "F",
			    "Women",
			    "Men"
			)
		lineageTag: 486d5a33-29ac-40a8-8ba3-be251174b7c7
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// AgeGroup
	column AgeGroup = ```
			
			VAR demo = Demographics[Demographic]
			RETURN
			SWITCH(
			    TRUE(),
			    LEFT(demo, 7) = "Females", MID(demo, 8, LEN(demo) - 7),
			    LEFT(demo, 5) = "Males", MID(demo, 6, LEN(demo) - 5),
			    BLANK()
			)
			
			```
		lineageTag: cb791adb-a72f-4f7a-be42-7fd4a36bf5d7
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// DemoCount_Tornado_Column
	column DemoCount_Tornado_Column = ```
			
			IF(
			    Demographics[Gender] = "Male",
			    -Demographics[DemoCount],
			    Demographics[DemoCount]
			)
			
			```
		formatString: 0
		lineageTag: b32cd07a-a276-423a-9902-ceec9c21a741
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	/// DemoLabel
	column DemoLabel = ```
			
			VAR demo = Demographics[Demographic]
			VAR gender = 
			    SWITCH(TRUE(),
			        LEFT(demo, 7) = "Females", "Women",
			        LEFT(demo, 5) = "Males", "Men",
			        BLANK()
			    )
			VAR rawAge = 
			    SWITCH(TRUE(),
			        LEFT(demo, 7) = "Females", MID(demo, 8, LEN(demo) - 7),
			        LEFT(demo, 5) = "Males", MID(demo, 6, LEN(demo) - 5),
			        BLANK()
			    )
			VAR formattedAge = 
			    SWITCH(TRUE(),
			        rawAge = "18", "18",
			        rawAge = "1834", "18–34",
			        rawAge = "3454", "34–54",
			        rawAge = "54+", "54+",
			        rawAge // fallback
			    )
			RETURN
			    IF(NOT(ISBLANK(gender)) && NOT(ISBLANK(formattedAge)),
			        gender & " " & formattedAge,
			        BLANK()
			    )
			
			```
		lineageTag: 3b57047b-3623-4704-a1d0-161ce097d392
		summarizeBy: none
		sortByColumn: SortOrder

		changedProperty = SortByColumn

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// SortOrder
	column SortOrder =
			
			SWITCH(
			    Demographics[Demographic],
			    "Males18", 1,
			    "Females18", 2,
			    "Females1834", 3,
			    "Males1834", 4,
			    "Females3454", 5,
			    "Males3454", 6,
			    "Females54", 7,
			    "Males54", 8,
			    99
			)
		formatString: 0
		lineageTag: bb94b05b-248c-455a-b33e-1a6c8e370c38
		summarizeBy: none

		changedProperty = SortByColumn

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

