	column Demographic_Slicer
		dataType: string
		lineageTag: 63da9ac1-9188-4f36-b2e5-1182bb810c9f
		summarizeBy: none
		sourceColumn: Demographic_Slicer

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

