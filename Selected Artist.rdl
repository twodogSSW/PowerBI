  </DataSources>
  <DataSets>
    <DataSet Name="DS_ArtistSales">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Artists">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!Artists.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>/*Declare @Artists AS int = '20'
Declare @StartDate AS DATETIME = '2025-01-01'
Declare @EndDate AS DATETIME = '2025-12-31'; */

SELECT
      a.pkArtist,
      a.Artist,      
      t.Title,
      t.Composer,
      g.Genre,
      ts.Salesdate,
      ts.SalesAmt
FROM 
      dbo.TrackList AS t
LEFT JOIN 
     dbo.Artist AS a   ON t.fkArtist  = a.pkArtist
LEFT JOIN 
      dbo.Genre AS g ON t.fkGenre       = g.pkGenre
LEFT JOIN 
      dbo.TrackSales AS ts ON t.pkTrackList   = ts.fkTrackList
WHERE
      a.pkArtist IN (@Artists)
AND (@StartDate IS NULL OR ts.Salesdate &gt;= @StartDate)
AND (@EndDate IS NULL OR ts.Salesdate &lt;= @EndDate)</CommandText>
      </Query>
      <Fields>
        <Field Name="pkArtist">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>pkArtist</DataField>
        </Field>
        <Field Name="Title">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Title</DataField>
        </Field>
        <Field Name="Artist">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Artist</DataField>
        </Field>
        <Field Name="Composer">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Composer</DataField>
        </Field>
        <Field Name="Genre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Genre</DataField>
        </Field>
        <Field Name="Salesdate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Salesdate</DataField>
        </Field>
        <Field Name="SalesAmt">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>SalesAmt</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
