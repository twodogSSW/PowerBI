  <DataSources>
    <DataSource Name="DSMusic">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=STDESKTOP\MSSQLSERVER02;Initial Catalog=Music2024</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>58cea85f-2099-484e-8ee1-b0ee71ad5ba8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DS_AlbumSales">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Album">
            <Value>=Parameters!Album.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>WITH AlbumData AS (
    SELECT
        al.pkAlbum            AS AlbumID,
        al.Album              AS Album,
        NULL                  AS Artist,
        NULL                  AS Title,
        SUM(als.SalesAmt)     AS TrackSalesAmt,
        SUM(als.SalesAmt)     AS SalesAmt,
        NULL                  AS SaleCount,
        MAX(als.SalesDate)    AS SalesDate
    FROM dbo.Album al
    LEFT JOIN dbo.AlbumSales als
        ON als.fkAlbum = al.pkAlbum
        AND als.SalesDate BETWEEN @StartDate AND @EndDate
    WHERE al.pkAlbum IN (@Album)
    GROUP BY al.pkAlbum, al.Album
),
TrackData AS (
    SELECT
        tl.fkAlbum            AS AlbumID,
        NULL                  AS Album,
        ar.Artist             AS Artist,
        tl.Title              AS Title,
        ts.SalesAmt           AS TrackSalesAmt,
        NULL                  AS SalesAmt,
        ts.SaleCount          AS SaleCount,
        ts.SalesDate          AS SalesDate
    FROM dbo.TrackList tl
    LEFT JOIN dbo.TrackSales ts
        ON ts.fkTrackList = tl.pkTrackList
        AND ts.SalesDate BETWEEN @StartDate AND @EndDate
    LEFT JOIN dbo.Artist ar
        ON ar.pkArtist = tl.fkArtist
    WHERE tl.fkAlbum IN (@Album)
)
(
    SELECT * FROM AlbumData
    UNION ALL
    SELECT * FROM TrackData
)
ORDER BY SalesDate DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="AlbumID">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>AlbumID</DataField>
        </Field>
        <Field Name="Album">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Album</DataField>
        </Field>
        <Field Name="Artist">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Artist</DataField>
        </Field>
        <Field Name="Title">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Title</DataField>
        </Field>
        <Field Name="SalesAmt">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>SalesAmt</DataField>
        </Field>
        <Field Name="SaleCount">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>SaleCount</DataField>
        </Field>
        <Field Name="SalesDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>SalesDate</DataField>
        </Field>
        <Field Name="TrackSalesAmt">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>TrackSalesAmt</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
