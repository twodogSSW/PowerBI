  <DataSets>
    <DataSet Name="DS_GenreSales">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Genre">
            <Value>=Parameters!Genre.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Artists">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!Genre.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pArtist">
            <Value>=Parameters!pArtist.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>WITH Months AS (
    SELECT DATEFROMPARTS(YEAR(@StartDate), MONTH(@StartDate), 1) AS MonthStart
    UNION ALL
    SELECT DATEADD(MONTH, 1, MonthStart)
    FROM Months
    WHERE MonthStart &lt; DATEFROMPARTS(YEAR(@EndDate), MONTH(@EndDate), 1)
)

SELECT
    a.pkArtist,
    a.Artist,
    t.Title,
    t.Composer,
    g.Genre,
    m.MonthStart,
    SUM(ts.SalesAmt) AS SalesAmt
FROM Months m
CROSS JOIN dbo.Genre g
LEFT JOIN dbo.TrackList t
    ON t.fkGenre = g.pkGenre
LEFT JOIN dbo.Artist a
    ON t.fkArtist = a.pkArtist
LEFT JOIN dbo.TrackSales ts
    ON t.pkTrackList = ts.fkTrackList
    AND DATEFROMPARTS(YEAR(ts.SalesDate), MONTH(ts.SalesDate), 1) = m.MonthStart
WHERE
    g.pkGenre IN (@Genre)
    AND a.pkArtist IN (@pArtist)
GROUP BY
    a.pkArtist,
    a.Artist,
    t.Title,
    t.Composer,
    g.Genre,
    m.MonthStart
ORDER BY g.Genre,Sum(SalesAmt) DESC
OPTION (MAXRECURSION 0);</CommandText>
      </Query>
      <Fields>
        <Field Name="pkArtist">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>pkArtist</DataField>
        </Field>
        <Field Name="Title">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Title</DataField>
        </Field>
        <Field Name="Artist">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Artist</DataField>
        </Field>
        <Field Name="Composer">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Composer</DataField>
        </Field>
        <Field Name="Genre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Genre</DataField>
        </Field>
        <Field Name="MonthStart">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>MonthStart</DataField>
        </Field>
        <Field Name="SalesAmt">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>SalesAmt</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsArtistFiltered">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Genre">
            <Value>=Parameters!Genre.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT a.pkArtist, a.Artist FROM dbo.TrackList AS t LEFT JOIN dbo.Artist a ON t.fkArtist = a.pkArtist LEFT JOIN dbo.Genre g ON t.fkGenre = g.pkGenre WHERE g.pkGenre IN (@Genre) ORDER BY a.Artist</CommandText>
      </Query>
      <Fields>
        <Field Name="pkArtist">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>pkArtist</DataField>
        </Field>
        <Field Name="Artist">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Artist</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsRegionFiltered">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Genre">
            <Value>=Parameters!Genre.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT DISTINCT 
           g.Genre,r.Region,geo.country, Sum(tr.SalesAmt) as Sales FROM 
dbo.TrackList AS t 
          LEFT JOIN dbo.Genre g ON t.fkGenre = g.pkGenre 
          LEFT JOIN dbo.TrackSales tr ON tr.fkTrackList = t.pkTrackList
          LEFT JOIN dbo.Geography geo ON geo.pkGeography= tr.fkGeographyNo
          LEFT JOIN dbo.Region r ON r.pkRegion= geo.fkRegion
     WHERE g.pkGenre IN (@Genre) and r.Region is not null
     GROUP BY  g.Genre,r.Region,geo.country</CommandText>
      </Query>
      <Fields>
        <Field Name="Genre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Genre</DataField>
        </Field>
        <Field Name="Region">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Region</DataField>
        </Field>
        <Field Name="country">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>country</DataField>
        </Field>
        <Field Name="Sales">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Sales</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsCalendar">
      <Query>
        <DataSourceName>DSMusic</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH Months AS (
   SELECT DATEFROMPARTS(YEAR(@StartDate), MONTH(@StartDate), 1) AS MonthStart
   UNION ALL
   SELECT DATEADD(MONTH, 1, MonthStart)  
   FROM Months
   WHERE MonthStart &lt; DATEFROMPARTS(YEAR(@EndDate), MONTH(@EndDate), 1)
   )

SELECT 
    m.MonthStart,
    SUM(s.SalesAmt) AS SalesAmt
FROM Months m
LEFT JOIN TrackSales s
    ON DATEFROMPARTS(YEAR(s.SalesDate), MONTH(s.SalesDate), 1) = m.MonthStart
GROUP BY m.MonthStart
OPTION (MAXRECURSION 0)
</CommandText>
      </Query>
      <Fields>
        <Field Name="MonthStart">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>MonthStart</DataField>
        </Field>
        <Field Name="SalesAmt">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>SalesAmt</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
