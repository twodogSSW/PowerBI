  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "After injuring my body in March 2024, I was unable to work and spent six months rehabbing and recooperating.  During that time, I were unable to use the computer and to keep up with Power Bi, I had to spend time reading and watching videos.  But that's not enough if you want to keep up with the changes. My contract ended with the CDC and I was on my own.",
                    "textStyle": {
                      "fontSize": "13.3333px"
                    }
                  },
                  {
                    "value": "             ",
                    "textStyle": {
                      "color": "#262a76"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "I wanted to return to the workforce, so my goal was returning to normal and being able to work an 8 hour workday (at the least)."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "So in late August as I became able to return to what I like to do, I built a music database with SQL Server 2022, and used the data to power the PowerBI Report."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The report is composed of the following."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "23,5K of music tracks, including Tracks and their detail which includes album, artists, genres and the record labels"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "SQL Code to create the tables and connect them to PBI."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Drawing inspiration from the book \"BIG BOOK OF DASHBOARDS - Visualizing your data using real world business scenarios\"."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Please let me know what you think!"
                  }
                ],
                "horizontalTextAlignment": "center"
              },
              {
                "textRuns": [
                  {
                    "value": "(more to come!)",
                    "textStyle": {
                      "fontStyle": "italic"
                    }
                  }
                ],
                "horizontalTextAlignment": "center"
              }
            ]
          }
        }
      ]
    },
